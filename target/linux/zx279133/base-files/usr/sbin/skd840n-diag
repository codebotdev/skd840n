#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Passive collection by default. --mdio explicitly reads only PHY ID registers.

case "$#:$1" in
	0:) mdio=0 ;;
	1:--mdio) mdio=1 ;;
	*) echo "Usage: skd840n-diag [--mdio]" >&2; exit 2 ;;
esac

section() { printf '\n=== %s ===\n' "$1"; }
show() {
	section "$1"
	if [ -r "$1" ]; then cat "$1"; else echo "not available"; fi
}

section 'Kernel and board'
uname -a
[ ! -r /tmp/sysinfo/model ] || cat /tmp/sysinfo/model
show /proc/cmdline
show /sys/devices/system/cpu/possible
show /sys/devices/system/cpu/present
show /sys/devices/system/cpu/online
show /proc/interrupts
show /proc/iomem
show /proc/meminfo
show /proc/mtd
section 'Network (BusyBox-compatible)'
ip link show
ip addr show
section 'MTD geometry and protection (no flash reads)'
for d in /sys/class/mtd/mtd[0-9]*; do
	[ -d "$d" ] || continue
	case "${d##*/}" in *ro) continue ;; esac
	printf '%s\n' "${d##*/}"
	for f in name type size erasesize writesize oobsize flags ecc_strength \
		ecc_step_size corrected_bits ecc_failures bad_blocks; do
		[ ! -r "$d/$f" ] || printf '  %s=%s\n' "$f" "$(cat "$d/$f")"
	done
done

if [ "$mdio" = 1 ]; then
	section 'Explicit PHY-ID reads; candidates are not port assignments'
	for d in /sys/bus/platform/devices/14f01000.mdio \
		/sys/bus/platform/devices/14f02000.mdio; do
		show "$d/phy_ids"
		show "$d/phy_ids_c45"
	done
fi

# Do not mount a filesystem or run register/flash scans implicitly.
show /sys/kernel/debug/clk/clk_summary
show /sys/kernel/debug/devices_deferred
section 'Kernel messages'
dmesg
section 'Limits'
echo 'No flash contents/configuration files read; no PHY writes or register scans.'
echo 'Review dmesg/cmdline locally for identifying information before sharing.'
